@startuml

skinparam Margin 15

title Bank Account Class Diagram

class BankAccount {
    +id: String 
    +Balance: double
    +createdAt: Date 
    +status: AccountStatus
    +currency: String
    +customer: Customer
    +accountOperations: List<Operation>
}


class CurrentAccount{
     +overDraft:double
}

class SavingAccount{
    +interestRate:double
}

CurrentAccount .up.|> BankAccount
SavingAccount .up.|> BankAccount


class Customer {
    +id: String
    +name: String
    +email: String
    +bankAccounts: List<BankAccount>
}

Customer "1" -- "0..*" BankAccount : owns

class Operation{
    +id: Long 
    +date: Date 
    +amount: double 
    +type: OperationType 
    +bankAccount: BankAccount
}

enum OperationType{
    CREDIT, DEBIT
}

Operation ..> OperationType : uses

enum AccountStatus{
    CREATED, ACTIVATED, SUSPENDED
}

BankAccount .up.> AccountStatus: uses



BankAccount "1" -up- "0..*" Operation : makes


@enduml